{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hath0r.dev/hath0r-msa-study-v1.schema.json",
  "title": "hath0r.evals.msa-study/v1",
  "description": "Gage R&R and attribute agreement study of the Hath0r eval pipeline (.hath0r/evals/msa/<study_id>.json).",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "study_id", "run_at", "parts", "operators", "replicates", "judge_fingerprint", "targets", "gage_rr", "attribute_agreement", "passed", "failures"],
  "properties": {
    "schema_version": {"const": "hath0r.evals.msa-study/v1"},
    "study_id": {"type": "string", "pattern": "^msa-"},
    "run_at": {"type": "string"},
    "panel": {"type": "string"},
    "parts": {"type": "integer", "minimum": 2},
    "operators": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "replicates": {"type": "integer", "minimum": 2},
    "judge_fingerprint": {"type": "string"},
    "targets": {
      "type": "object",
      "required": ["max_grr_pct", "min_ndc"],
      "properties": {"max_grr_pct": {"type": "number"}, "min_ndc": {"type": "number"}}
    },
    "gage_rr": {
      "type": "object",
      "required": ["grr_pct", "ndc", "variance_components", "study_variation_pct", "passed", "failures"],
      "properties": {
        "grr_pct": {"type": "number", "minimum": 0},
        "ndc": {"type": "integer", "minimum": 0},
        "variance_components": {"type": "object"},
        "study_variation_pct": {"type": "object"},
        "anova": {"type": "object"},
        "passed": {"type": "boolean"},
        "failures": {"type": "array", "items": {"type": "string"}}
      }
    },
    "attribute_agreement": {
      "type": "object",
      "required": ["effectiveness", "missed_defects", "false_alarms", "inconsistent_parts", "passed"],
      "properties": {
        "effectiveness": {"type": "number", "minimum": 0, "maximum": 1},
        "missed_defects": {"type": "array", "items": {"type": "string"}},
        "false_alarms": {"type": "array", "items": {"type": "string"}},
        "inconsistent_parts": {"type": "array", "items": {"type": "string"}},
        "passed": {"type": "boolean"}
      }
    },
    "passed": {"type": "boolean"},
    "failures": {"type": "array", "items": {"type": "string"}},
    "measurements": {"type": "array", "items": {"type": "object"}}
  }
}
