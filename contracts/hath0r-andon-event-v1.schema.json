{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hath0r.dev/hath0r-andon-event-v1.schema.json",
  "title": "hath0r.andon.event/v1",
  "description": "One record of the hash-chained Andon ledger (.hath0r/state/andon/events.jsonl).",
  "type": "object",
  "additionalProperties": true,
  "required": ["type", "event_id", "timestamp", "prev_hash", "hash"],
  "properties": {
    "type": {"type": "string", "enum": ["event", "ack", "clear", "note"]},
    "event_id": {"type": "string", "pattern": "^andon-"},
    "severity": {"type": "string", "enum": ["stop", "warn"]},
    "source": {"type": "string"},
    "reason": {"type": "string"},
    "workflow_id": {"type": ["string", "null"]},
    "step_id": {"type": ["string", "null"]},
    "details": {"type": "object"},
    "by": {"type": "string"},
    "note": {"type": "string"},
    "timestamp": {"type": "string"},
    "prev_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [{"if": {"properties": {"type": {"const": "event"}}}, "then": {"required": ["severity", "source", "reason"]}}]
}
