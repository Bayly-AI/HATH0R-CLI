{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hath0r.dev/hath0r-judge-calibration-v1.schema.json",
  "title": "hath0r.evals.judge-calibration/v1",
  "description": "Many-Facet Rasch calibration of LLM judges per complexity level (.hath0r/evals/judges/<calibration_id>.json, #615).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "calibration_id",
    "run_at",
    "domain",
    "judges",
    "gates",
    "analysis",
    "decisions",
    "passed"
  ],
  "properties": {
    "schema_version": {
      "const": "hath0r.evals.judge-calibration/v1"
    },
    "calibration_id": {
      "type": "string",
      "pattern": "^jcal-"
    },
    "run_at": {
      "type": "string"
    },
    "domain": {
      "enum": [
        "code",
        "reasoning",
        "jev"
      ]
    },
    "pilot": {
      "type": "boolean"
    },
    "judges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fingerprint"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "anchor": {
            "type": "boolean"
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "required": [
        "max_se",
        "max_mnsq",
        "removal_psi",
        "bh_q"
      ]
    },
    "analysis": {
      "type": "object",
      "required": [
        "fit",
        "bias",
        "decisions"
      ],
      "properties": {
        "fit": {
          "type": "object"
        },
        "bias": {
          "type": "object",
          "properties": {
            "cells": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "psi",
                    "se_clustered",
                    "n_ratings",
                    "n_parts"
                  ],
                  "properties": {
                    "psi": {
                      "type": "number"
                    },
                    "se_model": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "se_clustered": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "z": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "p_value": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "n_ratings": {
                      "type": "integer"
                    },
                    "n_parts": {
                      "type": "integer"
                    },
                    "infit": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "outfit": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "decisions": {
          "type": "object"
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "certified",
                "not_certified",
                "removed_noise",
                "removed_bias"
              ]
            },
            "reasons": {
              "type": "array"
            }
          }
        }
      }
    },
    "budget": {
      "type": "object"
    },
    "passed": {
      "type": "boolean"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
