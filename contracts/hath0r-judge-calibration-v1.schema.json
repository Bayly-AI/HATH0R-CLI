{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hath0r.dev/hath0r-judge-calibration-v1.schema.json",
  "title": "hath0r.evals.judge-calibration/v1",
  "description": "Study B: many-facet Rasch calibration of Hath0r judges per complexity level (.hath0r/evals/judges/<study_id>.json and latest.json, #615).",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "study_id", "created_at", "panel", "replicates", "judges", "banks", "spend_usd", "budget_usd", "complete"],
  "properties": {
    "schema_version": {"const": "hath0r.evals.judge-calibration/v1"},
    "study_id": {"type": "string", "pattern": "^judges-"},
    "created_at": {"type": "string"},
    "panel": {"type": "string"},
    "replicates": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer"},
    "judges": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "kind"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["truth", "stub", "anthropic", "ollama", "jev", "import"]}, "model": {"type": "string"}, "anchor": {"type": "boolean"}, "banks": {"type": "array", "items": {"type": "string"}}}}
    },
    "banks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["items_per_level", "ratings", "judges", "anchors"],
        "properties": {
          "items_per_level": {"type": "integer"},
          "ratings": {"type": "integer"},
          "anchors": {"type": "array", "items": {"type": "string"}},
          "error": {"type": "string"},
          "agreement_with_truth": {"type": "object"},
          "fit": {"type": "object"},
          "bias": {
            "type": "object",
            "required": ["by", "reference", "cells", "swings"],
            "properties": {
              "cells": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": ["psi", "se_clustered", "n_ratings", "n_parts"],
                    "properties": {"psi": {"type": ["number", "null"]}, "se_model": {"type": ["number", "null"]}, "se_clustered": {"type": ["number", "null"]}, "z": {"type": ["number", "null"]}, "p_value": {"type": ["number", "null"]}, "n_ratings": {"type": "integer"}, "n_parts": {"type": "integer"}, "infit": {"type": ["number", "null"]}, "outfit": {"type": ["number", "null"]}, "extreme_cell": {"enum": ["lowest", "highest"]}, "anchor": {"type": "boolean"}}
                  }
                }
              }
            }
          },
          "decisions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["status", "reasons", "bh_significant"],
                "properties": {"status": {"enum": ["certified", "not_certified", "removed_noise", "removed_bias"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "bh_significant": {"type": "boolean"}, "psi": {"type": ["number", "null"]}, "se_clustered": {"type": ["number", "null"]}}
              }
            }
          },
          "gates": {"type": "object", "required": ["max_se", "max_mnsq", "removal_psi", "bh_q"]},
          "summary": {"type": "object"}
        }
      }
    },
    "spend_usd": {"type": "number", "minimum": 0},
    "budget_usd": {"type": "number", "minimum": 0},
    "complete": {"type": "boolean"},
    "stopped_reason": {"type": ["string", "null"]},
    "errors": {"type": "object"},
    "ledger": {"type": ["object", "null"]}
  }
}
