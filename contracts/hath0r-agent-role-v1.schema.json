{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Bayly-AI/HATH0R-Agentic-Framework/development/contracts/hath0r-agent-role-v1.schema.json",
  "title": "Hath0rAgentRoleNode",
  "description": "Canonical schema contract for AgentGraph AgentRoleNode role capability and governance entities.",
  "type": "object",
  "required": [
    "id",
    "plane",
    "type",
    "label"
  ],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "enum": ["hath0r.agent-role/1", "1.0.0"],
      "description": "Schema version identifier for AgentRoleNode payloads."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the agent role (e.g. role:codebase_curator)."
    },
    "plane": {
      "type": "string",
      "enum": ["rules"],
      "description": "Always 'rules' for agent role nodes."
    },
    "type": {
      "type": "string",
      "enum": ["agent_role"],
      "description": "Entity classification type, always 'agent_role'."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable role name."
    },
    "content": {
      "type": "string",
      "description": "Role mission statement and behavioral instructions."
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "role_name": {
          "type": "string",
          "description": "Name of the agent role."
        },
        "scope": {
          "type": "string",
          "description": "Target workspace or subsystem boundary ('root', 'contracts', etc.)."
        },
        "permitted_tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tools authorized for this role."
        },
        "forbidden_tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tools explicitly blocked for this role."
        },
        "parent_role_id": {
          "type": ["string", "null"],
          "description": "Parent role from which capabilities and rules are inherited."
        },
        "max_subagents": {
          "type": "integer",
          "description": "Maximum concurrent child subagents this role is authorized to spawn."
        },
        "allowed_child_roles": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of role IDs this agent is permitted to delegate to."
        }
      }
    },
    "valid_from": {
      "type": ["string", "null"],
      "description": "ISO 8601 validity start."
    },
    "valid_to": {
      "type": ["string", "null"],
      "description": "ISO 8601 validity end."
    },
    "is_current": {
      "type": "boolean",
      "description": "Active state flag."
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 creation timestamp."
    },
    "updated_at": {
      "type": "string",
      "description": "ISO 8601 update timestamp."
    }
  }
}
