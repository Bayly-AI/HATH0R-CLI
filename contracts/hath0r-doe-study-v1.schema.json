{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hath0r.dev/hath0r-doe-study-v1.schema.json",
  "title": "hath0r.optimize.doe-study/v1",
  "description": "A design-of-experiments study from doe-bot (hath0r optimize screen|rsm|bayes|confirm, hath0r cccd calibrate --strategy sequential), stored in .hath0r/optimize/<study_id>.json.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "study_id", "kind", "factors", "created_at"],
  "properties": {
    "schema_version": {"const": "hath0r.optimize.doe-study/v1"},
    "study_id": {"type": "string", "pattern": "^doe-(screen|rsm|bayes)-"},
    "kind": {"type": "string", "enum": ["screen", "rsm", "bayes"]},
    "status": {"type": "string", "enum": ["awaiting_responses", "analysed"]},
    "factors": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
    "design": {"type": "array", "items": {"type": "object", "additionalProperties": {"type": "number"}}},
    "coded_design": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
    "responses": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
    "fraction": {"type": "integer", "minimum": 0},
    "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "anova": {"type": "object"},
    "significant_factors": {"type": "array", "items": {"type": "string"}},
    "design_type": {"type": "string", "enum": ["ccd", "bbd"]},
    "goal": {"type": "string", "enum": ["maximize", "minimize"]},
    "model": {"type": "object", "required": ["terms", "coefficients", "sigma"], "properties": {"terms": {"type": "array"}, "coefficients": {"type": "array"}, "sigma": {"type": "number", "minimum": 0}, "r2": {"type": "number"}}},
    "optimum": {"type": "object", "properties": {"coded": {}, "natural": {"type": "object"}, "predicted": {"type": "number"}, "interval": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}}},
    "confirmation": {"type": "object", "properties": {"confirmed": {"type": "boolean"}, "observed": {"type": "array", "items": {"type": "number"}}}},
    "trials": {"type": "array"},
    "fallback": {"type": "string"},
    "created_at": {"type": "string"}
  }
}
