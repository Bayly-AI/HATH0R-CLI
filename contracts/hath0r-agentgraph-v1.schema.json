{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Bayly-AI/HATH0R-Agentic-Framework/development/contracts/hath0r-agentgraph-v1.schema.json",
  "title": "Hath0rAgentGraphSnapshot",
  "description": "Canonical schema contract for Hath0r AgentGraph unified cognitive substrate snapshots, nodes, and relational edges.",
  "type": "object",
  "required": [
    "schema_version",
    "graph_id",
    "nodes",
    "edges"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["hath0r.agentgraph/1", "1.0.0"],
      "description": "Schema version identifier for AgentGraph payloads."
    },
    "graph_id": {
      "type": "string",
      "description": "Unique identifier for this AgentGraph instance or snapshot."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of graph snapshot creation."
    },
    "nodes": {
      "type": "array",
      "description": "Entities across knowledge, context, memory, rules, and extensible planes.",
      "items": {
        "$ref": "#/$defs/AgentGraphNode"
      }
    },
    "edges": {
      "type": "array",
      "description": "Relational connections between entities.",
      "items": {
        "$ref": "#/$defs/AgentGraphEdge"
      }
    }
  },
  "$defs": {
    "AgentGraphNode": {
      "type": "object",
      "required": [
        "id",
        "plane",
        "type",
        "label"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier for this node."
        },
        "plane": {
          "type": "string",
          "enum": ["knowledge", "context", "memory", "rules", "extensible"],
          "description": "Cognitive plane classification."
        },
        "type": {
          "type": "string",
          "enum": [
            "agent_role",
            "rule_policy",
            "knowledge_doc",
            "context_span",
            "memory_entity",
            "file_asset",
            "document",
            "contract",
            "code_module",
            "code_class",
            "code_function",
            "task",
            "tool_invocation"
          ],
          "description": "Entity classification type."
        },
        "label": {
          "type": "string",
          "description": "Display name or title of the node."
        },
        "content": {
          "type": "string",
          "description": "Textual payload, docstring, or policy content."
        },
        "properties": {
          "type": "object",
          "description": "Arbitrary typed attributes and metadata."
        },
        "valid_from": {
          "type": ["string", "null"],
          "description": "ISO 8601 timestamp representing the start of bitemporal validity."
        },
        "valid_to": {
          "type": ["string", "null"],
          "description": "ISO 8601 timestamp representing the end of bitemporal validity."
        },
        "is_current": {
          "type": "boolean",
          "description": "Whether this node is currently active."
        },
        "created_at": {
          "type": "string",
          "description": "ISO 8601 creation timestamp."
        },
        "updated_at": {
          "type": "string",
          "description": "ISO 8601 update timestamp."
        }
      }
    },
    "AgentGraphEdge": {
      "type": "object",
      "required": [
        "source",
        "target",
        "relation"
      ],
      "additionalProperties": true,
      "properties": {
        "source": {
          "type": "string",
          "description": "Source node identifier."
        },
        "target": {
          "type": "string",
          "description": "Target node identifier."
        },
        "relation": {
          "type": "string",
          "enum": [
            "GOVERNS",
            "INHERITS_FROM",
            "AUTHORIZES_TOOL",
            "RESTRICTED_BY",
            "CAN_SPAWN",
            "SUPERSEDES",
            "references",
            "contains",
            "calls",
            "depends_on"
          ],
          "description": "Relationship type linking source and target."
        },
        "plane": {
          "type": ["string", "null"],
          "description": "Plane classification for edge."
        },
        "weight": {
          "type": "number",
          "description": "Edge weight or traversal cost."
        },
        "valid_from": {
          "type": ["string", "null"],
          "description": "Start of bitemporal validity."
        },
        "valid_to": {
          "type": ["string", "null"],
          "description": "End of bitemporal validity."
        },
        "is_current": {
          "type": "boolean",
          "description": "Whether this edge is currently active."
        },
        "metadata": {
          "type": "object",
          "description": "Arbitrary edge metadata."
        }
      }
    }
  }
}
