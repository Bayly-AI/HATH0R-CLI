{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hath0r.bayly.ai/contracts/hath0r-decision-spec-v1.schema.json",
  "title": "Hath0r Cruise Control Decision Envelope & Specification Schema",
  "description": "Defines schema contract for the Cruise Control Agent Decision Control Layer, including decision envelopes, 7 canonical category wedges, dependency graph edges, transitive unblock scores, fact predicates, and work boundary gates.",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "category",
    "agent_id",
    "question",
    "status",
    "unblocks",
    "unblock_weight",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "hath0r.decision.spec/1"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "needs_card",
        "only_you_can_do_this",
        "approve_message",
        "set_product_rule",
        "start_hold_work",
        "accept_delivered_work",
        "keep_ledger_true"
      ]
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "WAITING_HUMAN",
        "WAITING_FACT",
        "RESOLVED_HUMAN",
        "SETTLED_BY_EVENT",
        "REJECTED"
      ]
    },
    "unblocks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unblock_weight": {
      "type": "number",
      "minimum": 0
    },
    "criticality": {
      "type": "number",
      "minimum": 0.1
    },
    "priority_tier": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "fact_predicate": {
      "type": ["string", "null"]
    },
    "settlement_reason": {
      "type": ["string", "null"]
    },
    "answer": {
      "type": ["string", "null"]
    },
    "operator": {
      "type": ["string", "null"]
    },
    "work_boundary": {
      "type": "string",
      "enum": ["DECISION", "INPUT", "OUTPUT"]
    },
    "boundary_payload": {
      "type": "object",
      "properties": {
        "token_budget": { "type": ["integer", "null"] },
        "tools": { "type": "array", "items": { "type": "string" } },
        "diff_summary": { "type": ["string", "null"] },
        "pr_draft": { "type": ["string", "null"] },
        "hmac_signature": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string"
    },
    "resolved_at": {
      "type": ["string", "null"]
    },
    "content_hash": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
