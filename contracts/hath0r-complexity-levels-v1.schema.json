{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.hath0r.dev/hath0r-complexity-levels-v1.schema.json",
  "title": "hath0r.evals.complexity-levels/v1",
  "description": "Complexity levels (code L1-L5 and MHC) and judge rating rubrics (cfg/evals/complexity-levels.yaml, #611).",
  "type": "object",
  "required": [
    "schema_version",
    "code",
    "mhc",
    "rubrics"
  ],
  "properties": {
    "schema_version": {
      "const": "hath0r.evals.complexity-levels/v1"
    },
    "code": {
      "type": "object",
      "required": [
        "levels",
        "min_kappa"
      ],
      "properties": {
        "min_kappa": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "classifier": {
          "type": "string"
        },
        "levels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "anchor",
              "examples"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^L[1-9]$"
              },
              "name": {
                "type": "string"
              },
              "anchor": {
                "type": "string",
                "minLength": 10
              },
              "proxies": {
                "type": "object"
              },
              "examples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "mhc": {
      "type": "object",
      "required": [
        "levels"
      ],
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "anchor"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9]{1,2}$"
              },
              "name": {
                "type": "string"
              },
              "anchor": {
                "type": "string"
              },
              "example": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "rubrics": {
      "type": "object",
      "required": [
        "scale"
      ],
      "properties": {
        "scale": {
          "type": "object",
          "required": [
            "min",
            "max"
          ]
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
